# Local Postgres. Create an empty database first:
#   CREATE DATABASE household_renewal_tracker;
#
# Use your own password. Do not commit the real .env file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/household_renewal_tracker

# Auth.js — required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Optional. App runs without these; email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Household Renewal Tracker <noreply@example.com>

# Optional private file storage. Without this, files save under /storage locally.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/reminders. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-string
